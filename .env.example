# Copie este arquivo para .env e ajuste os valores antes de executar a aplicação.
# O .env NUNCA deve ser commitado (já está no .gitignore).

# Chave usada para assinar os tokens JWT — gere a sua com: openssl rand -base64 48
# IMPORTANTE: não use este valor de exemplo; troque por uma chave gerada por você.
JWT_SECRET=troque-por-uma-chave-gerada-com-openssl-rand-base64-48

# Diretório onde os arquivos de mídia são gravados (opcional; default: ./storage)
STORAGE_DIR=./storage
